# Copy this file to `.env` and adjust values for your local environment.

APP_NAME="Real Estate Helpdesk API"
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://helpdesk:helpdesk@localhost:5432/helpdesk

JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256

SMTP_HOST=localhost
SMTP_PORT=1025

# Used once by `python -m app.core.seed` to bootstrap the single
# platform-level super-admin (there is no API endpoint for this). Not
# needed at normal runtime — only set these when running the seed script.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Stage 2 — ticket classification.
REDIS_URL=redis://localhost:6379/0

# "local" uses sentence-transformers (requires the `ml` extra); "openai"
# calls the OpenAI embeddings/chat API instead and does not need `ml`.
EMBEDDING_PROVIDER=local

# Only required when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Minimum classifier confidence to auto-apply a prediction (0.0-1.0).
CLASSIFIER_CONFIDENCE_THRESHOLD=0.6

# Directory containing the trained joblib artifacts (see
# scripts/train_classifier.py).
ML_ARTIFACTS_DIR=./ml_artifacts

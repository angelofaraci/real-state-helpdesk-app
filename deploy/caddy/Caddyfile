# Caddy reverse proxy — stage 8 (devops), PR11.
#
# `{$DOMAIN}` is read from the environment (`.env`, injected via
# `docker-compose.prod.yml`'s `env_file`) — deliberately NOT hardcoded.
# The production domain has not been decided/acquired yet, so this file
# must keep working unchanged once it is: point DNS at the instance, set
# `DOMAIN=example.com` in `.env`, redeploy. Caddy's automatic HTTPS
# (Let's Encrypt) takes care of the rest — no manual cert management.
#
# `caddy_data`/`caddy_config` (named volumes, see docker-compose.prod.yml)
# persist the ACME account and issued certificates across
# `docker compose up -d` redeploys.

{$DOMAIN} {
	reverse_proxy api:8000
}

grafana.{$DOMAIN} {
	reverse_proxy grafana:3000
}
